{
  "name": "storify-business-app",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "typegen": "uniwind generate-artifacts --css ./src/global.css --dts ./src/uniwind-types.d.ts && expo customize tsconfig.json",
    "typecheck": "pnpm typegen && tsc --noEmit",
    "lint": "expo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "doctor": "EXPO_PUBLIC_API_MOCK=1 pnpm dlx expo-doctor",
    "contracts:sync": "node scripts/contracts-sync.mjs",
    "contracts:check": "node scripts/contracts-sync.mjs --check",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm contracts:check"
  },
  "dependencies": {
