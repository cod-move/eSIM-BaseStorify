# Copy this file to .env.local and edit the copy. .env.local stays on your machine.
#
# Everything prefixed EXPO_PUBLIC_ is compiled into the app, where anyone who has
# the app can read it. Never put a password, a secret key or a token here.
#
# Cloud builds and updates do not read .env.local: give them the same variables
# in eas.json or with `eas env:set` (see the README).

# The store's default language. The app uses it for its very first request,
# before it has loaded the list of languages the store offers.
EXPO_PUBLIC_DEFAULT_LOCALE=en

# Two ways to run the app while you build it. Use one of them.
#
# 1. Mock store (the default). A mock store inside the app (src/api/mocks)
#    answers every request, so no server is needed and EXPO_PUBLIC_API_URL is
#    ignored. Everything works here: cart, checkout, account, orders.
EXPO_PUBLIC_API_MOCK=1
EXPO_PUBLIC_API_URL=
#
# 2. A live store. The app uses a store running on your computer, through the
#    development server: browsing, signing in, the cart, orders, everything. What
#    you do is saved in the store's database. To use it, switch off the two lines
#    of setup 1 (put a # in front of EXPO_PUBLIC_API_MOCK, or set it to 0) and use
#    these instead:
#
#    EXPO_PUBLIC_API_MOCK=0
#
#    The development server's own address, as the app reaches it: not the store's.
#    Use the port `pnpm start` prints. On a phone, "localhost" is the phone: use
#    your computer's network address instead, for example http://192.168.0.10:8081
#    EXPO_PUBLIC_API_URL=http://localhost:8081
#
#    The store the development server passes the app's requests on to. Only the
#    development server uses it; it never reaches the app. This is the default.
#    EXPO_PUBLIC_STORE_DEV_URL=http://localhost:3000
#
#    See "A store on your computer" in the README.

# The store's website, so that a link to it opens the app instead of a browser
# (iOS universal links, Android verified app links). The host only, no https://
# and no path; several hosts are separated by commas. Leave it unset during
# development: a build that claims a domain needs the website to vouch for the app
# (/.well-known/apple-app-site-association and /.well-known/assetlinks.json).
# It changes the native project: make a new build after changing it.
# STORE_DOMAIN=shop.example.com

# The app's identity, for a build under your own name. Each one is optional: the
# defaults in app.json apply when it is unset. They change the native project:
# make a new build after changing one.
# APP_NAME=My Shop
# APP_SLUG=my-shop
# APP_SCHEME=myshop
# APP_ANDROID_PACKAGE=com.example.myshop
# Pictures are paths from this folder; colours are #RRGGBB.
# APP_ICON=./assets/images/icon.png
# APP_ADAPTIVE_ICON_FOREGROUND=./assets/images/android-icon-foreground.png
# APP_ADAPTIVE_ICON_BACKGROUND=#FFFFFF
# APP_SPLASH_IMAGE=./assets/images/splash-icon.png
# APP_SPLASH_BACKGROUND=#2F2F2F

# "Continue with Google" on iOS: the client ID of the app's iOS OAuth client in
# Google Cloud (created for the app's bundle ID, in the same project as the
# store's web client). Unset, iOS shows no Google button; Android and the browser
# preview need nothing here (they use the store's web client, from GET /config).
# Public, like every EXPO_PUBLIC_ value. It changes the native project (its URL
# scheme): make a new build after changing it. See "Continue with Google" in the
# README.
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=123456789012-abc123.apps.googleusercontent.com

# Where "Become a vendor" sends a seller: the Storify Business app in the phone's
# app store. Unset, a placeholder listing is used.
# EXPO_PUBLIC_BUSINESS_APP_URL=https://play.google.com/store/apps/details?id=com.storify.business

# Where the Storify web app is checked out, for `pnpm contracts:sync` and
# `pnpm contracts:check`. Not EXPO_PUBLIC_: it never reaches the app. A relative
# path starts from this folder.
# STORIFY_MAIN_APP_DIR=../Storify-main-app
