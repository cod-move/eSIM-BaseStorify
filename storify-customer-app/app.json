{
  "expo": {
    "name": "CodSIM",
    "slug": "storify-shop",
    "version": "1.0.8",
    "scheme": "codsim",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "cc.codsim.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "cc.codsim.app",
      "versionCode": 9,
      "backgroundColor": "#F6F6F6",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "expo-localization",
      "expo-notifications",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to open your photos so you can add them to a review or a message.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to use the camera so you can take a photo for a review or a message.",
          "microphonePermission": false
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "",
          "enableGooglePay": true
        }
      ],
      "./plugins/with-gradle-memory",
      "./plugins/with-release-signing",
      "./plugins/with-no-overlay-permission"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "61cb58f8-ce06-4086-8343-1f77cb7a7239"
      }
    }
  }
}
